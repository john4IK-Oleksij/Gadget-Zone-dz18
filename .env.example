# Database Connection
DATABASE_URL=mysql+aiomysql://root:password@127.0.0.1:3306/gadget_zone_db

# Security & Authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_super_secret_key_hex_64_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Initial Owner / Admin Setup (Teacher requirement #4)
ADMIN_EMAIL=admin@gadgetzone.com
ADMIN_PASSWORD=change_this_secure_password

# CORS Settings
CORS_ORIGINS=["http://127.0.0.1:5500","http://localhost:5500"]
